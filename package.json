{
  "name": "purple",
  "private": true,
  "workspaces": ["client", "server"],
  "overrides": {
    "@sinclair/typebox": "0.34.52"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter purple-client build",
    "start": "cd server && NODE_ENV=production bun src/index.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "cd server && bun test"
  }
}
